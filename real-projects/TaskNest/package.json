{
  "name": "tasknest-fullstack-task-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Full stack task management app with React, Node.js, Express, SQLite database, JWT auth, and REST API.",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite --host 0.0.0.0",
    "server": "node server/src/index.js",
    "server:dev": "nodemon server/src/index.js",
    "db:init": "node server/src/db/init.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.0",
    "typescript": "^5.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "zustand": "^4.5.2",
    "lucide-react": "^0.468.0",
    "axios": "^1.6.7",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "better-sqlite3": "^9.4.0",
    "zod": "^3.23.8",
    "concurrently": "^8.2.2"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.33",
    "autoprefixer": "^10.4.16",
    "nodemon": "^3.0.3"
  }
}